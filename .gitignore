# Diretórios e arquivos de build
/.pio/
/build/
/out/

# Arquivos de cache e temporários
*.tmp
*.temp
*.bak
*.swp
*.swo
*.DS_Store
*.log

# Configurações específicas da IDE (inclui .vscode e .gitignore gerados pelo PlatformIO)
**/.vscode/
/.idea/
/*.code-workspace
/firmware/.gitignore

# Arquivos binários e de firmware gerados
*.elf
*.bin
*.hex
*.map

# Configurações específicas do sistema operacional
Thumbs.db
.DS_Store
*.stackdump

# Arquivos de configuração temporários ou locais
.env
*.ini
!firmware/platformio.ini
*.config

# Configurações sensíveis (credenciais WiFi, MQTT, DuckDNS, Tuya)
/data/config.json
/firmware/data/config.json

# Mosquitto runtime data e logs
mosquitto/data/
mosquitto/log/

# Home Assistant runtime (dados sensiveis: auth, banco, logs)
/homeassistant/config/.storage/
/homeassistant/config/.cache/
/homeassistant/config/*.db
/homeassistant/config/*.db-shm
/homeassistant/config/*.db-wal
/homeassistant/config/*.log
/homeassistant/config/*.log.*
/homeassistant/config/.ha_run.lock
/homeassistant/config/configuration.yaml
/homeassistant/config/backups/

# Cache da consulta de tarifa CEMIG/ANEEL (gerado pelo script)
/homeassistant/config/scripts/cemig_tarifa_cache.json

# Dmae (consumo de agua): I.D.A. do usuario + cache e HTML bruto da consulta
/homeassistant/config/scripts/dmae_secrets.json
/homeassistant/config/scripts/dmae_consumo_cache.json
/homeassistant/config/scripts/dmae_ultimo_extrato.html
__pycache__/

# Arquivos relacionados ao PlatformIO
**/.pio
**/.piolibdeps
*.d
*.o

# Arquivos de testes e mock
/tests/.output/

# Exclusões opcionais específicas do seu projeto
/spiffs_image.bin
