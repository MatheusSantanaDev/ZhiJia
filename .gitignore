# Diretórios e arquivos de build
/.pio/
/build/
/out/

# Arquivos de cache e temporários
*.tmp
*.temp
*.bak
*.swp
*.swo
*.DS_Store
*.log

# Configurações específicas da IDE
/.vscode/
/.idea/
/*.code-workspace

# Arquivos binários e de firmware gerados
*.elf
*.bin
*.hex
*.map

# Configurações específicas do sistema operacional
Thumbs.db
.DS_Store
*.stackdump

# Arquivos de configuração temporários ou locais
.env
*.ini
*.config

# Configurações sensíveis (credenciais WiFi, MQTT, DuckDNS, Tuya)
/data/config.json
/frontend/public/config.json

# Mosquitto runtime data e logs
mosquitto/data/
mosquitto/log/

# Home Assistant runtime (dados sensiveis: auth, banco, logs)
/homeassistant/config/.storage/
/homeassistant/config/.cache/
/homeassistant/config/*.db
/homeassistant/config/*.db-shm
/homeassistant/config/*.db-wal
/homeassistant/config/*.log
/homeassistant/config/*.log.*
/homeassistant/config/.ha_run.lock

# Clones do Home Assistant (fontes externas)
/homeassistant-core/
/homeassistant-frontend/

# Arquivos relacionados ao PlatformIO
**/.pio
**/.piolibdeps
*.d
*.o

# Arquivos de testes e mock
/tests/.output/

# Exclusões opcionais específicas do seu projeto
/spiffs_image.bin
